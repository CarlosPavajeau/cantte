---
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import { faq } from '@data/site'
---

<Section id="preguntas" title="Preguntas frecuentes">
  <div class="max-w-3xl divide-y border-y">
    {
      faq.map((item) => (
        <details class="group" name="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium transition-colors duration-150 hover:text-foreground/80 [&::-webkit-details-marker]:hidden">
            <h3 class="text-base">{item.question}</h3>
            <Icon
              name="plus"
              class="size-4 text-muted-foreground transition-transform duration-200 ease-out group-open:rotate-45"
            />
          </summary>
          <p class="max-w-[68ch] pb-6 text-pretty text-muted-foreground">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
