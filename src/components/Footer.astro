---
const year = new Date().getFullYear()
---

<footer id="contacto" class="border-t border-gray-200">
  <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-6">
      <span class="font-semibold text-gray-900 tracking-tight">cantte</span>
      <a
        href="mailto:contact@cantte.com"
        class="text-sm text-gray-500 hover:text-indigo-600 transition-colors duration-150"
      >
        contact@cantte.com
      </a>
    </div>
    <p class="text-sm text-gray-400">
      &copy; {year} cantte
    </p>
  </div>
</footer>
