---
import Section from '@components/Section.astro'
import { stack, steps } from '@data/site'
---

<Section
  id="proceso"
  title="Cómo trabajamos"
  lead="Un proceso corto y por escrito. Siempre sabes qué se está construyendo, cuánto cuesta y qué sigue."
>
  <ol class="divide-y border-y">
    {
      steps.map((step, i) => (
        <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-2 py-6 md:grid-cols-[4rem_minmax(0,4fr)_minmax(0,7fr)] md:gap-x-10">
          <span class="pt-0.5 font-mono text-sm tabular-nums text-muted-foreground" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="text-lg font-medium tracking-tight">{step.title}</h3>
          <p class="col-start-2 max-w-[68ch] text-pretty text-muted-foreground md:col-start-3">{step.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="grid gap-x-16 gap-y-8 border-t pt-12 lg:grid-cols-12">
    <div class="flex flex-col gap-3 lg:col-span-5">
      <h3 class="text-2xl font-medium tracking-tight">Con qué construimos</h3>
      <p class="text-pretty text-muted-foreground">
        La misma tecnología que mantiene a Cetus y Wappiz en producción. Elegimos la herramienta por el problema,
        no por la moda.
      </p>
    </div>
    <dl class="divide-y border-y lg:col-span-7">
      {
        stack.map((row) => (
          <div class="grid grid-cols-[6rem_1fr] gap-4 py-3.5 sm:grid-cols-[8rem_1fr]">
            <dt class="text-sm font-medium">{row.area}</dt>
            <dd class="font-mono text-xs leading-5 text-muted-foreground">{row.tools}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
