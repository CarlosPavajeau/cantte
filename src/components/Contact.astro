---
import Icon from '@components/Icon.astro'
import {
  contactMessage,
  mailtoHref,
  services,
  site,
  whatsappHref,
} from '@data/site'

const whatsapp = whatsappHref()
---

<section id="contacto" aria-labelledby="contacto-titulo" class="border-t bg-muted/40">
  <div class="mx-auto grid max-w-6xl gap-x-16 gap-y-12 px-4 py-section md:px-6 lg:grid-cols-12">
    <div class="flex flex-col gap-5 lg:col-span-5">
      <h2 id="contacto-titulo" class="text-balance text-3xl font-medium tracking-heading sm:text-4xl md:text-5xl md:leading-[1.05]">
        Tu proyecto es la siguiente entrada.
      </h2>
      <p class="text-pretty text-lg/8 text-muted-foreground">
        Cuéntanos qué necesitas. Te respondemos con preguntas concretas y, si encajamos, con una propuesta por
        escrito.
      </p>
      <p class="text-sm text-muted-foreground">
        O escribe directamente a
        <a href={mailtoHref()} class="font-mono text-xs text-foreground underline underline-offset-4">{site.email}</a>
      </p>
    </div>

    <form class="ring-card flex flex-col gap-6 rounded-xl bg-card p-5 sm:p-6 lg:col-span-7" data-contact-form>
      <fieldset class="flex flex-col gap-3">
        <legend class="mb-3 text-sm font-medium">¿Qué necesitas construir?</legend>
        <div class="flex flex-wrap gap-2">
          {
            services.map((service) => (
              <label class="cursor-pointer">
                <input type="radio" name="servicio" value={service.id} class="peer sr-only" />
                <span class="inline-flex h-9 items-center rounded-full border px-3.5 text-sm transition-colors duration-150 hover:bg-muted peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring">
                  {service.name}
                </span>
              </label>
            ))
          }
          <label class="cursor-pointer">
            <input type="radio" name="servicio" value="" class="peer sr-only" checked />
            <span class="inline-flex h-9 items-center rounded-full border px-3.5 text-sm transition-colors duration-150 hover:bg-muted peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring">
              Aún no lo sé
            </span>
          </label>
        </div>
      </fieldset>

      <div class="flex flex-col gap-2">
        <p class="text-sm font-medium" id="mensaje-label">Tu mensaje empezará así</p>
        <p
          aria-labelledby="mensaje-label"
          aria-live="polite"
          class="rounded-lg border bg-background px-4 py-3 text-sm text-muted-foreground"
          data-contact-message
        >
          {contactMessage(null)}
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={mailtoHref()} class="btn-primary" data-contact="mail">
          <Icon name="mail" />
          Enviar por correo
        </a>
        {
          whatsapp && (
            <a href={whatsapp} target="_blank" rel="noreferrer" class="btn-outline" data-contact="whatsapp">
              <img src="/images/whatsapp-icon.svg" alt="" class="size-4" width="16" height="16" />
              Hablar por WhatsApp
            </a>
          )
        }
      </div>
    </form>
  </div>
</section>

<script>
  import { contactMessage, mailtoHref, services, whatsappHref, type ServiceId } from '@data/site'

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
  const message = document.querySelector('[data-contact-message]')
  const logService = document.querySelector('[data-log-service]')
  const defaultLog = logService?.textContent ?? ''

  function apply(id: ServiceId | null) {
    if (message) message.textContent = contactMessage(id)
    document.querySelectorAll<HTMLAnchorElement>('[data-contact="mail"]').forEach((a) => {
      a.href = mailtoHref(id)
    })
    const wa = whatsappHref(id)
    if (wa) {
      document.querySelectorAll<HTMLAnchorElement>('[data-contact="whatsapp"]').forEach((a) => {
        a.href = wa
      })
    }
    if (logService) logService.textContent = services.find((s) => s.id === id)?.name ?? defaultLog
  }

  function select(id: ServiceId | null) {
    const input = form?.querySelector<HTMLInputElement>(`input[name="servicio"][value="${id ?? ''}"]`)
    if (input) input.checked = true
    apply(id)
  }

  form?.addEventListener('change', (event) => {
    const value = (event.target as HTMLInputElement).value
    apply((value || null) as ServiceId | null)
  })

  document.querySelectorAll<HTMLElement>('[data-pick-service]').forEach((button) =>
    button.addEventListener('click', () => select(button.dataset.pickService as ServiceId)),
  )
</script>
