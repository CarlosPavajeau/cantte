---
import Layout from '@layouts/Layout.astro'
---

<Layout
  title="cantte — Desarrollo de software y analítica de datos"
  description="Soluciones de software y analítica de datos que impulsan resultados reales de negocio."
>
  <!-- Hero -->
  <section class="pt-40 pb-32 md:pt-52 md:pb-40">
    <div class="max-w-6xl mx-auto px-6">
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-medium tracking-tight text-gray-900 leading-[1.1] animate-fade-in"
      >
        Construimos el futuro,<br />
        <span
          class="bg-gradient-to-r from-indigo-500 to-violet-500 bg-clip-text text-transparent"
          >una línea de código</span
        > a la vez.
      </h1>
      <p
        class="mt-8 text-lg md:text-xl text-gray-500 max-w-2xl leading-relaxed animate-fade-in-delay-1"
      >
        Creamos soluciones de software y analítica de datos que impulsan
        resultados reales de negocio.
      </p>
      <div class="mt-10 flex items-center gap-6 animate-fade-in-delay-2">
        <a
          href="#contacto"
          class="inline-flex items-center px-7 py-3.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-all duration-150 hover:shadow-lg hover:shadow-indigo-600/20"
        >
          Inicia un proyecto
        </a>
        <a
          href="#servicios"
          class="text-sm text-gray-600 hover:text-gray-900 transition-colors duration-150 group"
        >
          Conoce más
          <span
            class="inline-block ml-1 transition-transform duration-150 group-hover:translate-x-1"
            >&rarr;</span
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-6xl mx-auto px-6">
    <div class="h-px bg-gray-200"></div>
  </div>

  <!-- Services -->
  <section id="servicios" class="py-32 md:py-40">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-sm font-medium text-gray-400 uppercase tracking-widest mb-16"
      >
        Qué hacemos
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16">
        <div
          class="group p-8 -m-8 rounded-2xl border border-transparent hover:border-gray-200 transition-colors duration-200"
        >
          <h3 class="text-2xl font-medium text-gray-900 mb-4">
            Desarrollo de Software
          </h3>
          <p class="text-gray-500 leading-relaxed max-w-md">
            Aplicaciones web y móviles construidas con tecnologías modernas.
            Desde MVPs hasta plataformas empresariales, escribimos código limpio
            que escala con tu negocio.
          </p>
          <a
            href="#contacto"
            class="inline-block mt-6 text-sm text-gray-400 group-hover:text-indigo-600 transition-colors duration-150"
          >
            Más información &rarr;
          </a>
        </div>
        <div
          class="group p-8 -m-8 rounded-2xl border border-transparent hover:border-gray-200 transition-colors duration-200"
        >
          <h3 class="text-2xl font-medium text-gray-900 mb-4">
            Analítica de Datos
          </h3>
          <p class="text-gray-500 leading-relaxed max-w-md">
            Transformamos datos en decisiones. Dashboards, pipelines y modelos
            predictivos que revelan oportunidades ocultas en tu información.
          </p>
          <a
            href="#contacto"
            class="inline-block mt-6 text-sm text-gray-400 group-hover:text-indigo-600 transition-colors duration-150"
          >
            Más información &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-6xl mx-auto px-6">
    <div class="h-px bg-gray-200"></div>
  </div>

  <!-- Why Us -->
  <section class="py-32 md:py-40">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-sm font-medium text-gray-400 uppercase tracking-widest mb-16"
      >
        Por qué elegirnos
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-3">Rápido</h3>
          <p class="text-gray-500 leading-relaxed">
            Entregamos en semanas, no meses. Metodologías ágiles y un equipo
            enfocado en resultados concretos.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-3">Moderno</h3>
          <p class="text-gray-500 leading-relaxed">
            Stack tecnológico de vanguardia. TypeScript, React, Next.js, Python
            y las mejores herramientas de datos.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-3">Confiable</h3>
          <p class="text-gray-500 leading-relaxed">
            Código probado, documentado y mantenible. Construimos para durar,
            con estándares de calidad rigurosos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-b border-gray-200 py-32 md:py-40">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-medium tracking-tight text-gray-900">
        ¿Listo para construir algo grande?
      </h2>
      <div class="mt-10">
        <a
          href="mailto:contact@cantte.com"
          class="inline-flex items-center px-8 py-4 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-all duration-150 hover:shadow-lg hover:shadow-indigo-600/20"
        >
          Contáctanos
        </a>
      </div>
    </div>
  </section>
</Layout>
